<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SiteQueryDefectTracking.Mobile.Models"
             x:Class="SiteQueryDefectTracking.Mobile.Pages.QueryDetailPage"
             Title="Query Detail">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="16" Margin="8,8,8,4" StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#333333}"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
            <VerticalStackLayout Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <Label x:Name="IpoLabel" FontSize="20" FontAttributes="Bold" />
                    <Label x:Name="StatusLabel" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                </Grid>
                <Label x:Name="ProjectLabel" FontSize="13" />
                <Label x:Name="IssueTypeLabel" FontSize="13" />
                <Label x:Name="QuantityLabel" FontSize="13" />
                <Label x:Name="ProductLabel" FontSize="13" TextColor="Gray" />
                <Label x:Name="DispatchLabel" FontSize="13" />
                <Label x:Name="RaisedLabel" FontSize="12" TextColor="Gray" />
                <Label x:Name="DelayLabel" FontSize="13" TextColor="Red" />
                <Label x:Name="DescriptionLabel" FontSize="13" IsVisible="False" />
                <CollectionView x:Name="PhotoList" HeightRequest="90" IsVisible="False" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Image Source="{Binding .}" HeightRequest="80" WidthRequest="100" Aspect="AspectFill"
                                   Margin="4" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <CollectionView x:Name="CommentsList" Grid.Row="1" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No comments yet." HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CommentDto">
                    <Border Margin="8,4" Padding="10" StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#EEEEEE, Dark=#333333}"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding UserName}" FontSize="13" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding CreatedAt, StringFormat='{0:dd MMM HH:mm}'}"
                                       FontSize="11" TextColor="Gray" />
                            </Grid>
                            <Label Text="{Binding CommentText}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Padding="12,8" Spacing="8">
            <Grid ColumnDefinitions="*,8,*">
                <Entry Grid.Column="0" x:Name="CommentEntry" Placeholder="Add comment…" />
                <Button Grid.Column="2" Text="Post" Clicked="OnAddCommentClicked" />
            </Grid>
            <Grid ColumnDefinitions="*,8,*">
                <Button Grid.Column="0" x:Name="ResolveButton" Text="Mark Resolved"
                        Clicked="OnResolveClicked" BackgroundColor="#27AE60" />
                <Button Grid.Column="2" x:Name="EmailButton" Text="Email"
                        Clicked="OnEmailClicked" BackgroundColor="#2980B9" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>