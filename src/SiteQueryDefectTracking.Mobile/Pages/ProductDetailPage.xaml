<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SiteQueryDefectTracking.Mobile.Models"
             x:Class="SiteQueryDefectTracking.Mobile.Pages.ProductDetailPage"
             Title="Product">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label x:Name="CodeLabel" FontSize="24" FontAttributes="Bold" />
            <Label x:Name="DescriptionLabel" FontSize="14" />
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12" Margin="0,4,0,0">
                <Border Padding="8,2" StrokeShape="RoundRectangle 6" StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#2A2A2A}">
                    <Label x:Name="CategoryLabel" FontSize="12" />
                </Border>
                <Border Grid.Column="1" Padding="8,2" StrokeShape="RoundRectangle 6" StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#2A2A2A}">
                    <Label x:Name="UnitLabel" FontSize="12" />
                </Border>
            </Grid>
            <Label x:Name="BarcodeLabel" FontSize="12" TextColor="Gray" />

            <Label Text="Specifications" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0" />
            <CollectionView x:Name="SpecList" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProductSpecificationDto">
                        <Grid Padding="10,6" ColumnDefinitions="120,*">
                            <Label Grid.Column="0" Text="{Binding AttributeName}" FontSize="13" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="{Binding AttributeValue}" FontSize="13" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Used at projects" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0" />
            <CollectionView x:Name="ProjectList" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProductProjectMappingDto">
                        <Label Text="{Binding ProjectName}" FontSize="13" Padding="10,4" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>