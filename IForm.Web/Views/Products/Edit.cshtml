@model IForm.Web.ViewModels.ProductFormViewModel
@{
    ViewData["Title"] = "Edit Product";
    ViewData["PageTitle"] = "Edit Product";
    ViewData["PageSubtitle"] = "Update product catalogue entry";
    ViewData["ActiveMenu"] = "products";
}

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="card mb-2">
        <div class="card-header"><h2>Product details</h2></div>
        <div class="card-body">
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="ProductCode">Product code</label>
                    <input asp-for="ProductCode" class="form-control" autofocus />
                    <span asp-validation-for="ProductCode" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Name">Name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Family">Family</label>
                    <input asp-for="Family" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="Material">Material</label>
                    <input asp-for="Material" class="form-control" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Specification">Specification</label>
                    <input asp-for="Specification" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="Dimensions">Dimensions</label>
                    <input asp-for="Dimensions" class="form-control" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Project">Project</label>
                    <input asp-for="Project" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="Unit">Unit</label>
                    <input asp-for="Unit" class="form-control" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="IsActive">Status</label>
                    <select asp-for="IsActive" class="form-control">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="ImageFile">Product image</label>
                    <div class="form-row" style="grid-template-columns: auto 1fr; align-items: center;">
                        <img id="productImagePreview"
                             src="@(string.IsNullOrEmpty(Model.ImagePath) ? "/images/product-placeholder.svg" : Model.ImagePath)"
                             alt="@Model.ProductCode" style="width: 64px; height: 64px; object-fit: contain; border: 1px solid #e2e8f0; border-radius: 6px; background: #f8fafc;" />
                        <div>
                            <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp,.gif" class="form-control" onchange="var f=this.files[0]; if(f){var r=new FileReader(); r.onload=function(e){document.getElementById('productImagePreview').src=e.target.result;}; r.readAsDataURL(f);}" />
                            <span asp-validation-for="ImageFile" class="text-danger"></span>
                            <span class="text-muted text-sm">Upload a new photo to replace the current one (max 5 MB).</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="form-actions mt-2">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a class="btn btn-outline" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
