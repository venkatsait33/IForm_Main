@model IReadOnlyList<IForm.Web.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
    ViewData["PageTitle"] = "Notifications";
    ViewData["PageSubtitle"] = "Updates on your site queries";
}

<div class="row">
    <div style="flex: 1.6;">
        <div class="card">
            <div class="card-header">
                <h2>All notifications</h2>
                @if (Model.Any(n => !n.IsRead))
                {
                    <form asp-action="MarkAllRead" method="post" class="inline-form">
                        <button type="submit" class="btn btn-secondary btn-sm">Mark all read</button>
                    </form>
                }
            </div>
            <div class="card-body flush">
                @if (Model.Count == 0)
                {
                    <div class="empty-state">You have no notifications yet.</div>
                }
                else
                {
                    <div class="notification-list">
                        @foreach (var notification in Model)
                        {
                            <div class="notification-item @(notification.IsRead ? "" : "unread")">
                                @if (notification.SiteQueryId.HasValue)
                                {
                                    <a asp-controller="SiteQueries" asp-action="Details" asp-route-id="@notification.SiteQueryId.Value" class="notification-content">
                                        <strong>@notification.Title</strong>
                                        <span class="notification-body">@notification.Body</span>
                                        <span class="notification-time">@notification.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    </a>
                                }
                                else
                                {
                                    <div class="notification-content">
                                        <strong>@notification.Title</strong>
                                        <span class="notification-body">@notification.Body</span>
                                        <span class="notification-time">@notification.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                }
                                @if (!notification.IsRead)
                                {
                                    <form asp-action="MarkRead" asp-route-id="@notification.Id" method="post" class="inline-form">
                                        <button type="submit" class="icon-btn" title="Mark as read">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M22 11.08V12a10 10 0 11-5.93-9.14"></path><path d="M22 4L12 14.01l-3-3"></path>
                                            </svg>
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
