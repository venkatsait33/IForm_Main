@model IForm.Web.ViewModels.DispatchListViewModel
@{
    ViewData["Title"] = "Dispatch Tracker";
    ViewData["PageTitle"] = "Dispatch Tracker";
    ViewData["PageSubtitle"] = $"{Model.TotalCount} dispatch entr{(Model.TotalCount == 1 ? "y" : "ies")} on record · {Model.PendingCount} pending";
    ViewData["ActiveMenu"] = "dispatch";
}

@functions {
    string BuildUrl(int? page = null, bool resetPage = false)
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(Model.Search)) query.Add($"search={Uri.EscapeDataString(Model.Search)}");
        if (Model.Status.HasValue) query.Add($"status={Model.Status}");
        if (Model.Reason.HasValue) query.Add($"reason={Model.Reason}");
        query.Add($"page={(page ?? (resetPage ? 1 : Model.Page))}");
        return "?" + string.Join("&", query);
    }
}

<div class="card">
    <div class="card-header">
        <h2>Dispatch register</h2>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a class="btn btn-primary btn-sm" asp-action="Create">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                New Entry
            </a>
        }
    </div>
    <div class="filter-bar">
        <form method="get" asp-action="Index">
            <div class="filter-item" style="flex: 1 1 200px;">
                <input class="form-control" name="search" value="@Model.Search" placeholder="Search dispatch no, IPO, project..." />
            </div>
            <div class="filter-item">
                <select name="status" class="form-control">
                    <option value="">All statuses</option>
                    @foreach (var item in Model.StatusOptions)
                    {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                    }
                </select>
            </div>
            <div class="filter-item">
                <select name="reason" class="form-control">
                    <option value="">All reasons</option>
                    @foreach (var item in Model.ReasonOptions)
                    {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Apply</button>
            @if (Model.Search is not null || Model.Status.HasValue || Model.Reason.HasValue)
            {
                <a class="btn btn-outline" asp-action="Index">Clear</a>
            }
        </form>
    </div>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Dispatch No.</th>
                    <th>IPO</th>
                    <th>Project</th>
                    <th>Slab target</th>
                    <th>Slab completed</th>
                    <th>Slab delay</th>
                    <th>Qty</th>
                    <th>Dispatch status</th>
                    <th>Delay</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DispatchOrders.Count == 0)
                {
                    <tr>
                        <td colspan="10">
                            <div class="empty-state">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 8l-9-5-9 5 9 5 9-5v8"></path><path d="M3 8v8l9 5 9-5V8"></path>
                                </svg>
                                No dispatch entries match your filters.
                                <div class="mt-2"><a class="btn btn-sm btn-outline" asp-action="Create">Add a dispatch entry</a></div>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var order in Model.DispatchOrders)
                {
                    <tr>
                        <td><a class="ticket-id" asp-action="Details" asp-route-id="@order.Id">@order.DispatchNumber</a></td>
                        <td class="ticket-title">@order.IpoNumber</td>
                        <td>@order.Project</td>
                        <td class="text-muted text-sm">@(order.SlabTargetDate?.ToString("dd-MMM-yy") ?? "—")</td>
                        <td class="text-muted text-sm">@(order.SlabCompletedDate?.ToString("dd-MMM-yy") ?? "—")</td>
                        <td>
                            @if (order.SlabDelayDays.HasValue)
                            {
                                <span class="badge @UiClasses.DelayBadge(order.SlabDelayDays.Value)">@order.SlabDelayDays days</span>
                            }
                            else
                            {
                                <span class="text-muted text-sm">—</span>
                            }
                        </td>
                        <td class="text-muted text-sm">
                            @if (order.QuantityNos.HasValue)
                            {
                                @($"{order.QuantityNos} nos / {order.QuantitySqm?.ToString("F2") ?? "—"} sqm")
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td><span class="badge @UiClasses.DispatchStatus(order.DispatchStatus)">@order.DispatchStatus</span></td>
                        <td>
                            @if (order.DelayDays.HasValue)
                            {
                                <span class="badge @UiClasses.DelayBadge(order.DelayDays.Value)">@order.DelayDays days</span>
                            }
                            else
                            {
                                <span class="text-muted text-sm">—</span>
                            }
                        </td>
                        <td>
                            @if (order.Reason.HasValue)
                            {
                                <span class="badge @UiClasses.QueryCategory(order.Reason.Value)">@UiClasses.QueryCategory(order.Reason.Value)</span>
                            }
                            else
                            {
                                <span class="text-muted text-sm">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="pagination">
            <div class="page-info">
                Page @Model.Page of @Model.TotalPages &middot; @Model.TotalCount dispatch entr@(Model.TotalCount == 1 ? "y" : "ies")
            </div>
            <div class="pagination-controls">
                <a class="page-btn @(Model.Page <= 1 ? "disabled" : "")" href="@BuildUrl(page: Model.Page - 1)">&laquo; Prev</a>
                @{
                    var start = Math.Max(1, Model.Page - 2);
                    var end = Math.Min(Model.TotalPages, Model.Page + 2);
                }
                @for (var p = start; p <= end; p++)
                {
                    <a class="page-btn @(p == Model.Page ? "active" : "")" href="@BuildUrl(page: p)">@p</a>
                }
                <a class="page-btn @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@BuildUrl(page: Model.Page + 1)">Next &raquo;</a>
            </div>
        </div>
    }
</div>
