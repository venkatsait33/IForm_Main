@model IForm.Web.ViewModels.DispatchDetailViewModel
@{
    var o = Model.DispatchOrder;
    ViewData["Title"] = o.DispatchNumber;
    ViewData["PageTitle"] = o.DispatchNumber;
    ViewData["PageSubtitle"] = $"Dispatch entry for {o.Project} (IPO {o.IpoNumber})";
    ViewData["ActiveMenu"] = "dispatch";
}

<div class="card mb-2">
    <div class="card-header">
        <h2>Dispatch entry details</h2>
        @if (Model.CanEdit)
        {
            <a class="btn btn-outline btn-sm" asp-action="Edit" asp-route-id="@o.Id">Edit</a>
        }
    </div>
    <div class="card-body">
        <div class="form-row">
            <div class="form-group">
                <label>IPO number</label>
                <div class="form-control-static">@o.IpoNumber</div>
            </div>
            <div class="form-group">
                <label>Project</label>
                <div class="form-control-static">@o.Project</div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Slab target date</label>
                <div class="form-control-static">@(o.SlabTargetDate?.ToLocalTime().ToString("dd-MMM-yyyy") ?? "—")</div>
            </div>
            <div class="form-group">
                <label>Slab completed date</label>
                <div class="form-control-static">@(o.SlabCompletedDate?.ToLocalTime().ToString("dd-MMM-yyyy") ?? "—")</div>
            </div>
            <div class="form-group">
                <label>Slab delay</label>
                <div class="form-control-static">
                    @if (o.SlabDelayDays.HasValue)
                    {
                        <span class="badge @UiClasses.DelayBadge(o.SlabDelayDays.Value)">@o.SlabDelayDays days</span>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Qty (nos)</label>
                <div class="form-control-static">@(o.QuantityNos?.ToString() ?? "—")</div>
            </div>
            <div class="form-group">
                <label>Qty (sqm)</label>
                <div class="form-control-static">@(o.QuantitySqm?.ToString("F2") ?? "—")</div>
            </div>
            <div class="form-group">
                <label>Casting date</label>
                <div class="form-control-static">@(o.CastingDate?.ToLocalTime().ToString("dd-MMM-yyyy") ?? "—")</div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Dispatch status</label>
                <div class="form-control-static">
                    <span class="badge @UiClasses.DispatchStatus(o.DispatchStatus)">@o.DispatchStatus</span>
                </div>
            </div>
            <div class="form-group">
                <label>Dispatch date</label>
                <div class="form-control-static">@(o.DispatchDate?.ToLocalTime().ToString("dd-MMM-yyyy") ?? "Pending")</div>
            </div>
            <div class="form-group">
                <label>Overall delay</label>
                <div class="form-control-static">
                    @if (o.DelayDays.HasValue)
                    {
                        <span class="badge @UiClasses.DelayBadge(o.DelayDays.Value)">@o.DelayDays days</span>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Reason</label>
                <div class="form-control-static">
                    @if (o.Reason.HasValue)
                    {
                        <span class="badge @UiClasses.QueryCategory(o.Reason.Value)">@o.Reason</span>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(o.Remarks))
        {
            <div class="form-row">
                <div class="form-group" style="flex: 1 1 100%">
                    <label>Remarks</label>
                    <div class="form-control-static">@o.Remarks</div>
                </div>
            </div>
        }

        <div class="form-row">
            <div class="form-group">
                <label>Created by</label>
                <div class="form-control-static">@(o.CreatedBy?.FullName ?? "—")</div>
            </div>
            <div class="form-group">
                <label>Created on</label>
                <div class="form-control-static">@o.CreatedAt.ToString("dd-MMM-yyyy HH:mm")</div>
            </div>
        </div>
    </div>
</div>

<div class="form-actions">
    <a class="btn btn-outline" asp-action="Index">Back to register</a>
</div>
