@model IForm.Web.ViewModels.SiteQueryDetailViewModel
@{
    var q = Model.SiteQuery;
    ViewData["Title"] = q.QueryNumber;
    ViewData["PageTitle"] = q.QueryNumber;
    ViewData["PageSubtitle"] = $"{q.Project} - IPO {q.IpoNumber}";
    ViewData["ActiveMenu"] = "sitequeries";
}

@functions {
    static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name[..Math.Min(2, name.Length)];
    }
}

<div class="detail-header">
    <div class="detail-title">
        <h1>@q.Project</h1>
        <span class="badge @UiClasses.QueryStatus(q.Status)">@q.Status</span>
        <span class="badge @UiClasses.QueryCategory(q.Category)">@q.Category</span>
        <span class="badge @UiClasses.DelayBadge(q.DelayDays)">@q.DelayDays days delay</span>
        @if (UiClasses.IsEscalated(q))
        {
            <span class="badge badge-priority-critical" title="Open beyond the escalation threshold">Escalated</span>
        }
    </div>
    <div class="mt-2">
        <a class="btn btn-sm btn-outline" asp-action="Index">&larr; Back to queries</a>
        <a class="btn btn-sm btn-outline" asp-action="Pdf" asp-route-id="@q.Id" target="_blank">Download PDF</a>
        @if (Model.CanResolve)
        {
            <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@q.Id">Edit</a>
            <a class="btn btn-sm btn-outline" asp-action="Email" asp-route-id="@q.Id">Auto-email</a>
        }
    </div>
</div>

<div class="row">
    <div style="flex: 1.6;">
        <div class="card mb-2">
            <div class="card-header">
                <h2>Details</h2>
                <span class="text-muted text-sm">Raised @q.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
            </div>
            <div class="card-body">
                <div class="meta-grid mb-2">
                    <div class="meta-item">
                        <div class="meta-label">IPO number</div>
                        <div class="meta-value">@q.IpoNumber</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Issue type</div>
                        <div class="meta-value"><span class="badge @UiClasses.QueryCategory(q.Category)">@q.Category</span></div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Dispatch status</div>
                        <div class="meta-value"><span class="badge @UiClasses.QueryStatus(q.Status)">@q.Status</span></div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Delay</div>
                        <div class="meta-value"><span class="badge @UiClasses.DelayBadge(q.DelayDays)">@q.DelayDays days</span></div>
                    </div>
                </div>
                <div class="meta-grid mb-2">
                    <div class="meta-item">
                        <div class="meta-label">Quantity</div>
                        <div class="meta-value">@q.QuantityNos nos / @q.QuantitySqm sqm</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Verified product</div>
                        <div class="meta-value">
                            @if (q.Product is not null)
                            {
                                <span style="display: inline-flex; align-items: center; gap: 8px;">
                                    <img class="product-thumb"
                                         src="@(string.IsNullOrEmpty(q.Product.ImagePath) ? "/images/product-placeholder.svg" : q.Product.ImagePath)"
                                         alt="@q.Product.ProductCode" />
                                    @q.ProductCode
                                </span>
                            }
                            else
                            {
                                <span>@(q.ProductCode ?? "Not verified")</span>
                            }
                        </div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Raised by</div>
                        <div class="meta-value">@(q.RaisedBy?.FullName ?? "Unknown")</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Resolved by</div>
                        <div class="meta-value">
                            @if (q.Status == QueryStatus.Resolved)
                            {
                                @(q.ResolvedBy?.FullName ?? "—") <span class="text-muted text-sm">(@q.ResolvedAt?.ToLocalTime().ToString("MMM dd, yyyy"))</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="meta-grid mb-2">
                    <div class="meta-item">
                        <div class="meta-label">Slab target casting date</div>
                        <div class="meta-value">@(q.SlabTargetDate?.ToLocalTime().ToString("MMM dd, yyyy") ?? "—")</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Slab completed date</div>
                        <div class="meta-value">@(q.SlabCompletedDate?.ToLocalTime().ToString("MMM dd, yyyy") ?? "—")</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Slab delay days</div>
                        <div class="meta-value">@(q.SlabDelayDays?.ToString() ?? "—")</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Last updated</div>
                        <div class="meta-value">@(q.UpdatedAt?.ToLocalTime().ToString("MMM dd, yyyy HH:mm") ?? "—")</div>
                    </div>
                </div>

                <div class="section-title">Description</div>
                <div class="desc-box">@q.Description</div>

                @if (q.Photos.Count > 0)
                {
                    <div class="section-title mt-3">Photo evidence</div>
                    <div class="photo-grid">
                        @foreach (var photo in q.Photos)
                        {
                            <a href="@photo.FilePath" target="_blank">
                                <img src="@photo.FilePath" alt="Query photo" />
                            </a>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h2>Comments (@q.Comments.Count)</h2></div>
            <div class="card-body">
                @if (q.Comments.Count == 0)
                {
                    <div class="empty-state">No comments yet.</div>
                }
                @foreach (var comment in q.Comments.OrderBy(c => c.CreatedAt))
                {
                    <div class="comment-item">
                        <div class="avatar avatar-sm">@Initials(comment.User?.FullName)</div>
                        <div class="comment-body">
                            <div class="comment-meta">
                                <span class="comment-author">@(comment.User?.FullName ?? "System")</span>
                                <span class="comment-time">@comment.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                            </div>
                            <div class="comment-text">@comment.Body</div>
                        </div>
                    </div>
                }

                <form asp-action="AddComment" method="post" class="mt-2">
                    <input type="hidden" name="id" value="@q.Id" />
                    <div class="form-group mb-1">
                        <textarea name="newComment" class="form-control" placeholder="Add a comment or update..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Add comment</button>
                </form>
            </div>
        </div>
    </div>

    <div style="flex: 1;">
        @if (Model.CanResolve)
        {
            <div class="card mb-2">
                <div class="card-header"><h2>Dispatch status</h2></div>
                <div class="card-body">
                    <form asp-action="ChangeStatus" method="post">
                        <input type="hidden" name="id" value="@q.Id" />
                        <div class="form-group mb-1">
                            <select name="status" class="form-control">
                                @foreach (var status in Enum.GetValues<QueryStatus>())
                                {
                                    <option value="@status" selected="@(status == q.Status)">@status</option>
                                }
                            </select>
                        </div>
                        <div class="form-group mb-1">
                            <textarea name="resolutionNotes" class="form-control" placeholder="Resolution notes (optional)"></textarea>
                        </div>
                        <button type="submit" class="btn btn-success btn-block">Apply status</button>
                    </form>
                    @if (q.Status == QueryStatus.Resolved)
                    {
                        <div class="mt-2">
                            <a class="btn btn-primary btn-block" asp-action="Email" asp-route-id="@q.Id">Generate auto-email</a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
