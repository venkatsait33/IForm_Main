@model IForm.Web.ViewModels.TicketListViewModel
@{
    ViewData["Title"] = "All Tickets";
    ViewData["PageTitle"] = "All Tickets";
    ViewData["PageSubtitle"] = $"{Model.TotalCount} ticket{(Model.TotalCount == 1 ? "" : "s")} found";
    ViewData["ActiveMenu"] = "tickets";
}

@functions {
    static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name[..Math.Min(2, name.Length)];
    }

    string BuildUrl(string? sortBy = null, int? page = null, bool resetPage = false)
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(Model.Search)) query.Add($"search={Uri.EscapeDataString(Model.Search)}");
        if (Model.Status.HasValue) query.Add($"status={Model.Status}");
        if (Model.Priority.HasValue) query.Add($"priority={Model.Priority}");
        if (Model.Category.HasValue) query.Add($"category={Model.Category}");
        if (!string.IsNullOrWhiteSpace(Model.AssignedToId)) query.Add($"assignedToId={Model.AssignedToId}");
        if (!string.IsNullOrWhiteSpace(Model.SiteId)) query.Add($"siteId={Model.SiteId}");
        query.Add($"sortBy={Uri.EscapeDataString(sortBy ?? Model.SortBy)}");
        query.Add($"page={(page ?? (resetPage ? 1 : Model.Page))}");
        return "?" + string.Join("&", query);
    }
}

<div class="card">
    <div class="filter-bar">
        <form method="get" asp-action="Index">
            <div class="filter-item" style="flex: 1 1 260px;">
                <input class="form-control" name="search" value="@Model.Search" placeholder="Search ticket number, title, location..." />
            </div>
            <div class="filter-item">
                <select name="status" class="form-control">
                    <option value="">All statuses</option>
                    @foreach (var item in Model.StatusOptions)
                    {
                        <option value="@item.Value" selected="@(item.Selected)">@item.Text</option>
                    }
                </select>
            </div>
            <div class="filter-item">
                <select name="priority" class="form-control">
                    <option value="">All priorities</option>
                    @foreach (var item in Model.PriorityOptions)
                    {
                        <option value="@item.Value" selected="@(item.Selected)">@item.Text</option>
                    }
                </select>
            </div>
            <div class="filter-item">
                <select name="category" class="form-control">
                    <option value="">All categories</option>
                    @foreach (var item in Model.CategoryOptions)
                    {
                        <option value="@item.Value" selected="@(item.Selected)">@item.Text</option>
                    }
                </select>
            </div>
            <div class="filter-item">
                <select name="assignedToId" class="form-control">
                    <option value="">Anyone assigned</option>
                    @foreach (var user in Model.Users)
                    {
                        <option value="@user.Id" selected="@(user.Id == Model.AssignedToId)">@user.FullName</option>
                    }
                </select>
            </div>
            <div class="filter-item">
                <select name="siteId" class="form-control">
                    <option value="">All sites</option>
                    @foreach (var site in Model.Sites)
                    {
                        <option value="@site.Id" selected="@(site.Id.ToString() == Model.SiteId)">@site.Name</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Apply</button>
            @if (Model.Search is not null || Model.Status.HasValue || Model.Priority.HasValue || Model.Category.HasValue || !string.IsNullOrEmpty(Model.AssignedToId) || !string.IsNullOrEmpty(Model.SiteId))
            {
                <a class="btn btn-outline" asp-action="Index">Clear</a>
            }
        </form>
    </div>

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th><a href="@BuildUrl("created_desc")">Ticket</a></th>
                    <th><a href="@BuildUrl("title")">Title</a></th>
                    <th><a href="@BuildUrl("priority")">Priority</a></th>
                    <th>Status</th>
                    <th>Category</th>
                    <th>Site</th>
                    <th>Reported By</th>
                    <th>Assigned To</th>
                    <th>Created</th>
                    <th>Due</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Tickets.Count == 0)
                {
                    <tr>
                        <td colspan="10">
                            <div class="empty-state">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                </svg>
                                No tickets match your filters.
                                <div class="mt-2"><a class="btn btn-sm btn-outline" asp-action="Create">Report a new ticket</a></div>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var ticket in Model.Tickets)
                {
                    <tr>
                        <td><a class="ticket-id" asp-action="Details" asp-route-id="@ticket.Id">@ticket.TicketNumber</a></td>
                        <td class="ticket-title"><a asp-action="Details" asp-route-id="@ticket.Id">@ticket.Title</a></td>
                        <td><span class="badge @UiClasses.Priority(ticket.Priority)">@ticket.Priority</span></td>
                        <td><span class="badge @UiClasses.Status(ticket.Status)">@ticket.Status</span></td>
                        <td><span class="badge @UiClasses.Category(ticket.Category)">@ticket.Category</span></td>
                        <td class="text-muted text-sm">@(ticket.Site?.Name ?? "—")</td>
                        <td>
                            <span class="cell-avatar">
                                <div class="avatar avatar-sm">@(Initials(ticket.ReportedBy?.FullName))</div>
                                <span>@(ticket.ReportedBy?.FullName ?? "Unknown")</span>
                            </span>
                        </td>
                        <td>
                            @if (ticket.AssignedTo is not null)
                            {
                                <span class="cell-avatar">
                                    <div class="avatar avatar-sm" style="background: #0ea5e9;">@(Initials(ticket.AssignedTo.FullName))</div>
                                    <span>@ticket.AssignedTo.FullName</span>
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Unassigned</span>
                            }
                        </td>
                        <td class="text-muted text-sm">@ticket.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</td>
                        <td class="text-muted text-sm">
                            @(ticket.DueDate?.ToLocalTime().ToString("MMM dd") ?? "—")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="pagination">
            <div class="page-info">
                Page @Model.Page of @Model.TotalPages &middot; @Model.TotalCount ticket(s)
            </div>
            <div class="pagination-controls">
                <a class="page-btn @(Model.Page <= 1 ? "disabled" : "")" href="@BuildUrl(page: Model.Page - 1)">&laquo; Prev</a>
                @{
                    var start = Math.Max(1, Model.Page - 2);
                    var end = Math.Min(Model.TotalPages, Model.Page + 2);
                }
                @for (var p = start; p <= end; p++)
                {
                    <a class="page-btn @(p == Model.Page ? "active" : "")" href="@BuildUrl(page: p)">@p</a>
                }
                <a class="page-btn @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@BuildUrl(page: Model.Page + 1)">Next &raquo;</a>
            </div>
        </div>
    }
</div>
