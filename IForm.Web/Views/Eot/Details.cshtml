@model IForm.Web.ViewModels.EotDetailViewModel
@{
    var eot = Model.EotRequest;
    var netScope = (eot.ScopeAddition ?? 0) - (eot.ScopeReduction ?? 0);
    var complete = EotDocuments.IsComplete(eot);
    var scenarioDescription = eot.Scenario switch
    {
        EotScenario.Sc1 => "Production Completed & Changes Initiated",
        EotScenario.Sc2 => "Production Partially Completed & Changes Initiated",
        EotScenario.Sc3 => "Production Not Started & Changes Initiated",
        _ => ""
    };
    ViewData["Title"] = eot.EotNumber;
    ViewData["PageTitle"] = eot.EotNumber;
    ViewData["PageSubtitle"] = $"{eot.Project} - {eot.Category}";
    ViewData["ActiveMenu"] = "eot";
}

<div class="detail-header">
    <div class="detail-title">
        <h1>@eot.EotNumber</h1>
        <span class="badge @UiClasses.EotCategory(eot.Category)">@eot.Category</span>
        <span class="badge @UiClasses.Scenario(eot.Scenario.GetValueOrDefault())">@(eot.Scenario?.ToString() ?? "—")</span>
        <span class="badge @UiClasses.EotSubmissionStatus(eot.SubmissionStatus)">@eot.SubmissionStatus</span>
        <span class="badge @UiClasses.EotClientApproval(eot.ClientApproval)">@eot.ClientApproval</span>
    </div>
    <div class="mt-2">
        <a class="btn btn-sm btn-outline" asp-action="Index">&larr; Back to register</a>
        @if (Model.CanEdit)
        {
            <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@eot.Id">Edit</a>
        }
        <a class="btn btn-sm btn-outline" asp-action="Email" asp-route-id="@eot.Id">Auto-email</a>
    </div>
</div>

<div class="row">
    <div style="flex: 1.6;">
        <div class="card mb-2">
            <div class="card-header">
                <h2>Details</h2>
                <span class="text-muted text-sm">Created @eot.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
            </div>
            <div class="card-body">
                <div class="meta-grid mb-2">
                    <div class="meta-item">
                        <div class="meta-label">Project</div>
                        <div class="meta-value">@eot.Project</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Client</div>
                        <div class="meta-value">@(eot.Client ?? "—")</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Financial year</div>
                        <div class="meta-value">@(eot.FinancialYear ?? "—")</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Revision number</div>
                        <div class="meta-value">@(eot.RevisionNumber?.ToString() ?? "—")</div>
                    </div>
                </div>
                <div class="meta-grid mb-2">
                    <div class="meta-item">
                        <div class="meta-label">EOT category</div>
                        <div class="meta-value"><span class="badge @UiClasses.EotCategory(eot.Category)">@eot.Category</span></div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Scenario</div>
                        <div class="meta-value">
                            @if (eot.Scenario.HasValue)
                            {
                                <span class="badge @UiClasses.Scenario(eot.Scenario.Value)">@eot.Scenario</span>
                                <span class="text-muted text-sm">@scenarioDescription</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Change proposed by</div>
                        <div class="meta-value">@(eot.ChangeProposedBy?.ToString() ?? "—")</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Reference</div>
                        <div class="meta-value">@(eot.Reference ?? "—")</div>
                    </div>
                </div>
                <div class="meta-grid mb-2">
                    <div class="meta-item">
                        <div class="meta-label">SPA date</div>
                        <div class="meta-value">@(eot.SpaDate?.ToLocalTime().ToString("MMM dd, yyyy") ?? "—")</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Design revision date</div>
                        <div class="meta-value">@(eot.DesignRevisionDate?.ToLocalTime().ToString("MMM dd, yyyy") ?? "—")</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Estimated time impact</div>
                        <div class="meta-value">@(eot.EstimatedTimeImpactDays?.ToString() ?? "—") days</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Estimated cost impact</div>
                        <div class="meta-value">@(eot.EstimatedCostImpact?.ToString("N0") ?? "To be Assessed")</div>
                    </div>
                </div>
                <div class="meta-grid mb-2">
                    <div class="meta-item">
                        <div class="meta-label">Delay (days)</div>
                        <div class="meta-value">
                            @if (eot.DelayDays.HasValue)
                            {
                                <span class="badge @UiClasses.DelayBadge(eot.DelayDays.Value)">@eot.DelayDays days</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Cost escalation</div>
                        <div class="meta-value">@(eot.CostEscalation ?? "—")</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Submission status</div>
                        <div class="meta-value"><span class="badge @UiClasses.EotSubmissionStatus(eot.SubmissionStatus)">@eot.SubmissionStatus</span></div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Client approval</div>
                        <div class="meta-value"><span class="badge @UiClasses.EotClientApproval(eot.ClientApproval)">@eot.ClientApproval</span></div>
                    </div>
                </div>

                <div class="section-title">Reason</div>
                <div class="desc-box">@eot.Reason</div>
                @if (!string.IsNullOrWhiteSpace(eot.Remarks))
                {
                    <div class="section-title mt-3">Remarks</div>
                    <div class="desc-box">@eot.Remarks</div>
                }
                <div class="mt-2 text-muted text-sm">Prepared by @(eot.CreatedBy?.FullName ?? "—") &middot; Last updated @(eot.UpdatedAt?.ToLocalTime().ToString("MMM dd, yyyy HH:mm") ?? "—")</div>
            </div>
        </div>

        <div class="card mb-2">
            <div class="card-header"><h2>Design / scope change analysis</h2></div>
            <div class="card-body flush">
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Original approved scope</td>
                                <td>@(eot.OriginalApprovedScope ?? "—")</td>
                            </tr>
                            <tr>
                                <td>Revised scope</td>
                                <td>@(eot.RevisedScope ?? "—")</td>
                            </tr>
                            <tr>
                                <td>Scope addition (+)</td>
                                <td>@(eot.ScopeAddition?.ToString("N2") ?? "—") sqm</td>
                            </tr>
                            <tr>
                                <td>Scope reduction (-)</td>
                                <td>@(eot.ScopeReduction?.ToString("N2") ?? "—") sqm</td>
                            </tr>
                            <tr>
                                <td><strong>Net scope variation</strong></td>
                                <td><strong>@netScope.ToString("N2") sqm</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div style="flex: 1;">
        <div class="card mb-2">
            <div class="card-header">
                <h2>Required documents</h2>
                <span class="badge @(complete ? "badge-status-resolved" : "badge-priority-high")">@(complete ? "Complete" : "Incomplete")</span>
            </div>
            <div class="card-body">
                @foreach (var doc in EotDocuments.Required)
                {
                    var present = doc.Property switch
                    {
                        nameof(EotRequest.HasApprovedDrawings) => eot.HasApprovedDrawings,
                        nameof(EotRequest.HasRevisedDrawings) => eot.HasRevisedDrawings,
                        nameof(EotRequest.HasClientInstructions) => eot.HasClientInstructions,
                        nameof(EotRequest.HasDelayAnalysis) => eot.HasDelayAnalysis,
                        nameof(EotRequest.HasScopeVariationStatement) => eot.HasScopeVariationStatement,
                        nameof(EotRequest.HasProgressReport) => eot.HasProgressReport,
                        nameof(EotRequest.HasConsultantCorrespondence) => eot.HasConsultantCorrespondence,
                        _ => eot.HasSupportingDocuments
                    };
                    <div class="meta-item">
                        <div class="meta-label">@doc.Label @(doc.Mandatory ? "" : "(optional)")</div>
                        <div class="meta-value">
                            @if (present)
                            {
                                <span class="badge badge-status-resolved">On file</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Not attached</span>
                            }
                        </div>
                    </div>
                }
                @if (!complete)
                {
                    <div class="mt-2 text-muted text-sm">Incomplete submissions shall not be processed.</div>
                }
            </div>
        </div>

        @if (Model.CanEdit)
        {
            <div class="card">
                <div class="card-header"><h2>Actions</h2></div>
                <div class="card-body">
                    <a class="btn btn-primary btn-block" asp-action="Edit" asp-route-id="@eot.Id">Edit EOT</a>
                    <a class="btn btn-outline btn-block mt-2" asp-action="Email" asp-route-id="@eot.Id">Generate auto-email</a>
                </div>
            </div>
        }
    </div>
</div>
