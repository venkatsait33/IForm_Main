@model IForm.Web.ViewModels.MaterialCertificateDetailViewModel
@{
    var c = Model.Certificate;
    ViewData["Title"] = c.CertificateNumber;
    ViewData["PageTitle"] = c.CertificateNumber;
    ViewData["PageSubtitle"] = $"Test certificate for {c.Supplier}";
    ViewData["ActiveMenu"] = "mtc";
}

<div class="card mb-2">
    <div class="card-header">
        <h2>Certificate details</h2>
        @if (Model.CanEdit)
        {
            <a class="btn btn-outline btn-sm" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
        }
    </div>
    <div class="card-body">
        <div class="form-row">
            <div class="form-group">
                <label>Supplier</label>
                <div class="form-control-static">@c.Supplier</div>
            </div>
            <div class="form-group">
                <label>Supplier report no / Lab no</label>
                <div class="form-control-static">@(c.SupplierReportNo ?? "—")</div>
            </div>
            <div class="form-group">
                <label>Work order no</label>
                <div class="form-control-static">@(c.WorkOrderNo ?? "—")</div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Alloy / grade</label>
                <div class="form-control-static">@(c.Alloy ?? "—")</div>
            </div>
            <div class="form-group">
                <label>Test method</label>
                <div class="form-control-static">@(c.TestMethod ?? "—")</div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Report date</label>
                <div class="form-control-static">@(c.ReportDate?.ToLocalTime().ToString("dd-MMM-yyyy") ?? "—")</div>
            </div>
            <div class="form-group">
                <label>Sample received date</label>
                <div class="form-control-static">@(c.SampleReceivedDate?.ToLocalTime().ToString("dd-MMM-yyyy") ?? "—")</div>
            </div>
            <div class="form-group">
                <label>Test date</label>
                <div class="form-control-static">@(c.TestDate?.ToLocalTime().ToString("dd-MMM-yyyy") ?? "—")</div>
            </div>
            <div class="form-group">
                <label>Valid until</label>
                <div class="form-control-static">@(c.ValidUntil?.ToLocalTime().ToString("dd-MMM-yyyy") ?? "—")</div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(c.Remarks))
        {
            <div class="form-row">
                <div class="form-group" style="flex: 1 1 100%">
                    <label>Remarks / test results</label>
                    <div class="form-control-static">@c.Remarks</div>
                </div>
            </div>
        }

        @if (c.FilePath is not null)
        {
            <div class="form-row">
                <div class="form-group">
                    <label>Attached report</label>
                    <div class="form-control-static">
                        <a class="btn btn-outline btn-sm" asp-action="Download" asp-route-id="@c.Id">Download @(c.FileName ?? "file")</a>
                    </div>
                </div>
            </div>
        }

        <div class="form-row">
            <div class="form-group">
                <label>Uploaded by</label>
                <div class="form-control-static">@(c.UploadedBy?.FullName ?? "—")</div>
            </div>
            <div class="form-group">
                <label>Created on</label>
                <div class="form-control-static">@c.CreatedAt.ToString("dd-MMM-yyyy HH:mm")</div>
            </div>
        </div>
    </div>
</div>

<div class="form-actions">
    <a class="btn btn-outline" asp-action="Index">Back to register</a>
</div>
