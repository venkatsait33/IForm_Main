@model IForm.Web.ViewModels.SiteFormViewModel
@{
    ViewData["Title"] = "Add Site";
    ViewData["PageTitle"] = "Add Site";
    ViewData["PageSubtitle"] = "Create a new operational site";
    ViewData["ActiveMenu"] = "sites";
}

<div class="card" style="max-width: 640px;">
    <div class="card-header"><h2>New site</h2></div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Code">Code</label>
                    <input asp-for="Code" class="form-control" autofocus placeholder="e.g. SITE-01" />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Name">Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Houston Plant" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Address">Address</label>
                <input asp-for="Address" class="form-control" />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="City">City</label>
                    <input asp-for="City" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="Country">Country</label>
                    <input asp-for="Country" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label>
                    <input type="checkbox" asp-for="IsActive" class="form-check-input" /> Active
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Create site</button>
                <a class="btn btn-outline" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
