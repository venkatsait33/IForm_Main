@model IForm.Web.ViewModels.IncidentFormViewModel
@{
    ViewData["Title"] = "Report Incident";
    ViewData["PageTitle"] = "Report a New Incident";
    ViewData["PageSubtitle"] = "Record an incident, near miss or unsafe condition";
    ViewData["ActiveMenu"] = "incidents";
}

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="card mb-2">
        <div class="card-header"><h2>Incident details</h2></div>
        <div class="card-body">
            <div class="form-group">
                <label asp-for="Title">Title</label>
                <input asp-for="Title" class="form-control" autofocus placeholder="Short summary of the incident" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" class="form-control" placeholder="What happened, who was involved, and what was the outcome?"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Type">Type</label>
                    <select asp-for="Type" asp-items="Model.TypeOptions" class="form-control"></select>
                </div>
                <div class="form-group">
                    <label asp-for="Severity">Severity</label>
                    <select asp-for="Severity" asp-items="Model.SeverityOptions" class="form-control"></select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="OccurredAt">Date &amp; time occurred</label>
                    <input asp-for="OccurredAt" type="datetime-local" class="form-control" />
                    <span asp-validation-for="OccurredAt" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="SiteId">Site</label>
                    <select asp-for="SiteId" class="form-control">
                        <option value="">Select site</option>
                        @foreach (var site in Model.Sites)
                        {
                            <option value="@site.Value">@site.Text</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Location">Location on site</label>
                    <input asp-for="Location" class="form-control" placeholder="e.g. Loading Bay 3, Zone B" />
                </div>
                <div class="form-group">
                    <label asp-for="PersonsInvolved">Persons involved</label>
                    <input asp-for="PersonsInvolved" type="number" min="0" class="form-control" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="IsWorkRelated">Work related?</label>
                    <select asp-for="IsWorkRelated" class="form-control">
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="DaysLost">Days lost (if any)</label>
                    <input asp-for="DaysLost" type="number" min="0" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label asp-for="ImmediateActionTaken">Immediate action taken</label>
                <textarea asp-for="ImmediateActionTaken" class="form-control" placeholder="What was done right away to make the area safe?"></textarea>
            </div>
        </div>
    </div>

    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <div class="card">
            <div class="card-header"><h2>Workflow</h2></div>
            <div class="card-body">
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Status">Status</label>
                        <select asp-for="Status" asp-items="Model.StatusOptions" class="form-control"></select>
                    </div>
                    <div class="form-group">
                        <label asp-for="AssignedToId">Assign investigator</label>
                        <select asp-for="AssignedToId" class="form-control">
                            <option value="">Unassigned</option>
                            @foreach (var user in Model.Users)
                            {
                                <option value="@user.Value">@user.Text</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="form-actions mt-2">
        <button type="submit" class="btn btn-primary">Report incident</button>
        <a class="btn btn-outline" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
