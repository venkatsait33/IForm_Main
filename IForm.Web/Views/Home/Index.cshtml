@{
    ViewData["Title"] = "IFORM - Safety & Incident Management";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IFORM - Safety &amp; Incident Management</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="landing">
        <nav class="landing-nav">
            <div class="sidebar-brand" style="border: none; padding: 0;">
                <div class="brand-logo">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        <path d="M9 12l2 2 4-4"></path>
                    </svg>
                </div>
                <div class="brand-text">
                    <strong>IFORM</strong>
                    <span>Safety &amp; Incident Management</span>
                </div>
            </div>
            <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Sign in</a>
        </nav>

        <div class="landing-hero">
            <div>
                <h1>Rapid reporting.<br />Rapid resolution.</h1>
                <p>Report incidents, unsafe acts, near misses and hazards in seconds. Track every ticket through investigation, action and closure.</p>
                <a class="btn btn-primary" asp-controller="Account" asp-action="Login">
                    Sign in to the dashboard
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
            </div>
        </div>

        <div class="landing-features">
            <div class="landing-feature">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"></path>
                    <rect x="9" y="3" width="6" height="4" rx="1"></rect><path d="M9 12h6"></path><path d="M9 16h6"></path>
                </svg>
                <h3>Ticket management</h3>
                <p>Full lifecycle tracking from report to closure with statuses, priorities and assignments.</p>
            </div>
            <div class="landing-feature">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                </svg>
                <h3>Rich reporting</h3>
                <p>Categories for incidents, near misses, unsafe acts, unsafe conditions and hazards.</p>
            </div>
            <div class="landing-feature">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="9" rx="1"></rect><rect x="14" y="3" width="7" height="5" rx="1"></rect>
                    <rect x="14" y="12" width="7" height="9" rx="1"></rect><rect x="3" y="16" width="7" height="5" rx="1"></rect>
                </svg>
                <h3>Live dashboard</h3>
                <p>KPI cards and charts give leadership complete visibility of safety performance.</p>
            </div>
            <div class="landing-feature">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 00-3-3.87"></path><path d="M16 3.13a4 4 0 010 7.75"></path>
                </svg>
                <h3>Role-based access</h3>
                <p>Admins, managers and users get tailored permissions and views.</p>
            </div>
        </div>
    </div>
</body>
</html>
