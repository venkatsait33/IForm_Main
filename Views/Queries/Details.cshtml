@model QueryDetailViewModel
@{
    var q = Model.Query;
    var delayDays = q.Status == QueryStatus.Resolved
        ? ((q.ResolvedAt ?? q.RaisedAt).Date - q.RaisedAt.Date).Days
        : (DateTime.UtcNow.Date - q.RaisedAt.Date).Days;
    var delayClass = delayDays >= 30 ? "delay-high" : (delayDays >= 15 ? "delay-medium" : "delay-low");
    ViewData["Title"] = $"Query {q.IPO} - {q.Project?.Name}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Query @q.IPO <span class="text-muted fs-6">/ @q.Project?.Name</span></h4>
        <span class="text-muted">@q.QueryNumber &middot; Raised @q.RaisedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Queries" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
        @if (Model.IsManager)
        {
            <a asp-controller="Queries" asp-action="Email" asp-route-id="@q.Id" class="btn btn-outline-primary">
                <i class="bi bi-envelope-plus me-1"></i>Auto Email
            </a>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header"><i class="bi bi-file-earmark-text me-2"></i>Issue Details</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="text-muted small">IPO Number</div>
                        <div class="fw-semibold">@q.IPO</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">Project</div>
                        <div class="fw-semibold">@q.Project?.Name</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">Issue Type</div>
                        <div><span class="badge-issue badge-@q.IssueType">@q.IssueType</span></div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">Status</div>
                        <div><span class="badge-status badge-@q.Status">@q.Status</span></div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">Qty (Nos)</div>
                        <div class="fw-semibold">@q.QtyNos</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">Qty (SQM)</div>
                        <div class="fw-semibold">@q.QtySqm</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">Delay</div>
                        <div><span class="delay-pill @delayClass">@delayDays d</span></div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">Product Code</div>
                        <div class="fw-semibold">@(q.ProductCode != null ? $"{q.ProductCode.Code} - {q.ProductCode.Name}" : "Not linked")</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">Slab Target Date</div>
                        <div>@(q.SlabTargetDate?.ToString("dd/MM/yyyy") ?? "-")</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">Slab Completed Date</div>
                        <div>@(q.SlabCompletedDate?.ToString("dd/MM/yyyy") ?? "-")</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">Slab Delay (Days)</div>
                        <div>@(q.SlabDelayDays?.ToString() ?? "-")</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">Raised By</div>
                        <div>@q.RaisedBy?.FullName</div>
                    </div>
                    @if (q.ResolvedBy != null)
                    {
                        <div class="col-md-3">
                            <div class="text-muted small">Resolved By</div>
                            <div>@q.ResolvedBy.FullName <span class="text-muted small">@q.ResolvedAt?.ToLocalTime().ToString("dd/MM/yyyy")</span></div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(q.Description))
                    {
                        <div class="col-12">
                            <div class="text-muted small">Description</div>
                            <div>@q.Description</div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(q.PhotoPath))
                {
                    <div class="mt-3">
                        <div class="text-muted small mb-2">Photo Evidence</div>
                        <a href="@q.PhotoPath" target="_blank">
                            <img src="@q.PhotoPath" class="query-photo" alt="Query photo" />
                        </a>
                    </div>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header"><i class="bi bi-chat-left-text me-2"></i>Comments</div>
            <div class="card-body">
                @if (q.Comments.Any())
                {
                    foreach (var c in q.Comments.OrderBy(x => x.CreatedAt))
                    {
                        <div class="d-flex gap-3 mb-3">
                            <div class="user-avatar" style="width:34px;height:34px;">@(c.User?.FullName?.Substring(0, 1).ToUpperInvariant())</div>
                            <div class="flex-grow-1 bg-light rounded p-3">
                                <div class="d-flex justify-content-between">
                                    <span class="fw-semibold small">@c.User?.FullName</span>
                                    <span class="text-muted small">@c.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                                </div>
                                <div class="mt-1">@c.Text</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted text-center py-3">No comments yet.</div>
                }

                <form asp-action="AddComment" asp-controller="Queries" method="post" class="mt-3">
                    <input type="hidden" name="id" value="@q.Id" />
                    <div class="input-group">
                        <input type="text" name="text" class="form-control" placeholder="Add an update or comment..." required />
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="bi bi-send me-1"></i>Post
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        @if (Model.IsManager && q.Status != QueryStatus.Resolved)
        {
            <div class="card mb-4 border-success">
                <div class="card-header bg-success text-white"><i class="bi bi-check2-circle me-2"></i>Manager Actions</div>
                <div class="card-body">
                    @if (q.Status == QueryStatus.Pending)
                    {
                        <form asp-action="ChangeStatus" asp-controller="Queries" method="post" class="mb-2">
                            <input type="hidden" name="id" value="@q.Id" />
                            <input type="hidden" name="status" value="@((int)QueryStatus.InProgress)" />
                            <button type="submit" class="btn btn-outline-primary w-100">
                                <i class="bi bi-play me-1"></i>Start In Progress
                            </button>
                        </form>
                    }
                    <form asp-action="ChangeStatus" asp-controller="Queries" method="post"
                          onsubmit="return confirm('Mark this query as Resolved? This action is audit-logged.');">
                        <input type="hidden" name="id" value="@q.Id" />
                        <input type="hidden" name="status" value="@((int)QueryStatus.Resolved)" />
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-check-circle me-1"></i>Mark Resolved
                        </button>
                    </form>
                </div>
            </div>
        }
        else if (!Model.IsManager && q.Status != QueryStatus.Resolved)
        {
            <div class="card mb-4 bg-light">
                <div class="card-body text-center">
                    <i class="bi bi-shield-lock text-muted fs-4 d-block mb-2"></i>
                    <span class="small text-muted">Only the Manager role can mark this query as Resolved.</span>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header"><i class="bi bi-clock-history me-2"></i>Audit Trail</div>
            <div class="card-body">
                @if (q.AuditLogs.Any())
                {
                    <ul class="timeline">
                        @foreach (var a in q.AuditLogs)
                        {
                            var color = a.Action == "Resolved" ? "green" : (a.Action == "Raised" ? "amber" : "");
                            <li class="timeline-item @color">
                                <div class="fw-semibold small">@a.Action</div>
                                <div class="text-muted small">@a.User?.FullName &middot; @a.Timestamp.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-muted text-center py-3">No audit records.</div>
                }
            </div>
        </div>
    </div>
</div>
