@model DashboardViewModel
@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Delivery &amp; Delay Overview</h4>
        <span class="text-muted">Live status of all site queries, updated in real time.</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Queries" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Report Issue
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="bi bi-files"></i></div>
            <div>
                <div class="stat-value">@Model.TotalQueries</div>
                <div class="stat-label">Total Queries</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon amber"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="stat-value">@Model.OpenQueries</div>
                <div class="stat-label">Pending</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="bi bi-arrow-repeat"></i></div>
            <div>
                <div class="stat-value">@Model.InProgressQueries</div>
                <div class="stat-label">In Progress</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon green"><i class="bi bi-check2-circle"></i></div>
            <div>
                <div class="stat-value">@Model.ResolvedQueries</div>
                <div class="stat-label">Resolved</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon purple"><i class="bi bi-building"></i></div>
            <div>
                <div class="stat-value">@Model.ActiveProjects</div>
                <div class="stat-label">Active Projects</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon red"><i class="bi bi-alarm"></i></div>
            <div>
                <div class="stat-value">@Model.MaxOpenDays</div>
                <div class="stat-label">Max Open (days)</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card table-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-exclamation-octagon text-danger me-2"></i>Open Delays by Severity</span>
                <a asp-controller="Queries" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>IPO</th>
                            <th>Project</th>
                            <th>Issue Type</th>
                            <th>Raised By</th>
                            <th>Delay</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var rank = 1; }
                        @foreach (var q in Model.OpenDelays)
                        {
                            var delayClass = q.DelayDays >= 30 ? "delay-high" : (q.DelayDays >= 15 ? "delay-medium" : "delay-low");
                            <tr>
                                <td class="text-muted fw-semibold">@rank</td>
                                <td class="fw-semibold">@q.IPO</td>
                                <td>@q.Project</td>
                                <td><span class="badge-issue badge-@q.IssueType">@q.IssueType</span></td>
                                <td>@q.RaisedBy</td>
                                <td><span class="delay-pill @delayClass">@q.DelayDays d</span></td>
                                <td><span class="badge-status badge-@q.Status">@q.Status</span></td>
                                <td>
                                    <a asp-controller="Queries" asp-action="Details" asp-route-id="@q.Id"
                                       class="btn btn-sm btn-icon btn-outline-primary" title="Open record">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                            rank++;
                        }
                        @if (!Model.OpenDelays.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="bi bi-check-circle me-2 text-success"></i>No open queries. All caught up!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-header"><i class="bi bi-pie-chart me-2"></i>Open Queries by Issue Type</div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="issueChart"></canvas>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><i class="bi bi-collection me-2"></i>Issue Type Summary</div>
            <div class="card-body">
                @{
                    var total = Math.Max(1, Model.OpenByIssueType.Values.Sum());
                    var colors = new Dictionary<IssueType, string>
                    {
                        { IssueType.Missing, "#dc2626" },
                        { IssueType.ProductionMistake, "#d97706" },
                        { IssueType.DesignMistake, "#2563eb" },
                        { IssueType.DispatchMissing, "#7c3aed" }
                    };
                }
                @foreach (var kv in Model.OpenByIssueType)
                {
                    var pct = Math.Round(kv.Value * 100.0 / total, 1);
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="small fw-semibold">@kv.Key</span>
                            <span class="small text-muted">@kv.Value open (@pct%)</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar"
                                 style="width: @pct%; background-color: @colors[kv.Key];"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/chart.min.js"></script>
    <script>
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpenByIssueType.Keys.Select(k => k.ToString())));
        const values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpenByIssueType.Values.ToArray()));
        const ctx = document.getElementById('issueChart').getContext('2d');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: values,
                    backgroundColor: ['#dc2626', '#d97706', '#2563eb', '#7c3aed'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12, padding: 14 } }
                }
            }
        });
    </script>
}
