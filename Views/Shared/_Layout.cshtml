<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - I-FORM Quality Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon"><i class="bi bi-archive"></i></div>
                <div>
                    <div class="brand-name">I-FORM</div>
                    <div class="brand-sub">Quality Portal</div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section">MAIN</div>
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Dashboard" ? "active" : "")"
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i><span>Dashboard</span>
                </a>
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Report" ? "active" : "")"
                   asp-controller="Queries" asp-action="Create">
                    <i class="bi bi-plus-circle"></i><span>Report Issue</span>
                </a>
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Queries" ? "active" : "")"
                   asp-controller="Queries" asp-action="Index">
                    <i class="bi bi-search"></i><span>Search &amp; Resolve</span>
                </a>

                <div class="nav-section">CATALOGUE</div>
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Products" ? "active" : "")"
                   asp-controller="Products" asp-action="Index">
                    <i class="bi bi-box-seam"></i><span>Product Lookup</span>
                </a>

                <div class="nav-section">PROJECTS</div>
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "EOT" ? "active" : "")"
                   asp-controller="Eot" asp-action="Index">
                    <i class="bi bi-calendar2-week"></i><span>EOT Management</span>
                </a>
                @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                {
                    <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Tracker" ? "active" : "")"
                       asp-controller="Tracker" asp-action="Index">
                        <i class="bi bi-file-earmark-bar-graph"></i><span>Site Tracker</span>
                    </a>
                }
            </nav>

            <div class="sidebar-footer">
                <div class="d-flex align-items-center gap-2">
                    <div class="user-avatar">@(User.Identity?.Name?.Substring(0, 1).ToUpperInvariant())</div>
                    <div class="user-meta">
                        <div class="user-name">@User.Identity?.Name</div>
                        <div class="user-role">@(User.IsInRole("Manager") || User.IsInRole("Admin") ? "Manager" : "Site Engineer")</div>
                    </div>
                </div>
            </div>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-link d-lg-none text-dark p-0" id="sidebarToggle">
                        <i class="bi bi-list fs-3"></i>
                    </button>
                    <div class="topbar-title">@ViewData["Title"]</div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="topbar-date" id="currentDate"></span>
                    <div class="dropdown">
                        <button class="btn btn-light dropdown-toggle" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li><span class="dropdown-item-text small text-muted">Signed in as</span></li>
                            <li><span class="dropdown-item fw-semibold">@User.Identity?.Name</span></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>&copy; 2026 I-FORM Aluminium &amp; Design LLP &mdash; Site Query &amp; Defect Tracking System</span>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
