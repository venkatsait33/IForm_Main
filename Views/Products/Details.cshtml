@model Product
@{
    ViewData["Title"] = $"Product {Model.Code}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">@Model.Code</h4>
        <span class="text-muted">@Model.Name</span>
    </div>
    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Catalogue
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <div class="text-muted small">Code</div>
                <div class="fw-semibold fs-5" style="color:var(--primary);">@Model.Code</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Name</div>
                <div class="fw-semibold">@Model.Name</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Category</div>
                <div class="fw-semibold">@Model.Category</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Material</div>
                <div class="fw-semibold">@Model.Material</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">Specification</div>
                <div>@Model.Specification</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">Mapped Project</div>
                <div>@(Model.Project?.Name ?? "General catalogue item")</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">Status</div>
                <div>@(Model.IsActive ? "Active" : "Inactive")</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="col-12">
                    <div class="text-muted small">Description</div>
                    <div>@Model.Description</div>
                </div>
            }
        </div>
    </div>
</div>
