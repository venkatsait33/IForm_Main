@model ProductListViewModel
@{
    ViewData["Title"] = "Product Code Lookup";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Product Code Lookup</h4>
        <span class="text-muted">Confirm the exact product before reporting - no more guesswork.</span>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Search Code / Name / Material</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control"
                           placeholder="e.g. DAAA, Snap Tie, Steel, PVC..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Category</label>
                <select name="category" class="form-select">
                    <option value="">All Categories</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c" selected="@(Model.Category == c)">@c</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<div class="row g-3">
    @foreach (var p in Model.Products)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card h-100 product-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h6 class="mb-0 fw-bold" style="color:var(--primary);">@p.Code</h6>
                            <div class="text-muted small mt-1">@p.Name</div>
                        </div>
                        @if (!string.IsNullOrEmpty(p.Category))
                        {
                            <span class="badge bg-light text-dark border">@p.Category</span>
                        }
                    </div>
                    <hr class="my-2">
                    <div class="small text-muted">
                        @if (!string.IsNullOrEmpty(p.Description))
                        {
                            <div class="mb-1"><i class="bi bi-card-text me-1"></i>@p.Description</div>
                        }
                        @if (!string.IsNullOrEmpty(p.Specification))
                        {
                            <div class="mb-1"><i class="bi bi-rulers me-1"></i><span class="fw-semibold text-dark">Spec:</span> @p.Specification</div>
                        }
                        @if (!string.IsNullOrEmpty(p.Material))
                        {
                            <div><i class="bi bi-gear me-1"></i><span class="fw-semibold text-dark">Material:</span> @p.Material</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!Model.Products.Any())
    {
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center text-muted py-5">
                    <i class="bi bi-box display-6 d-block mb-2"></i>
                    No products match your search.
                </div>
            </div>
        </div>
    }
</div>
